---
// src/pages/blog/[...slug].astro
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('cs-CZ', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(date);
};
---

<BaseLayout 
  title={`${post.data.title} | Patrik Rybka`}
  description={post.data.description}
>
  <article class="py-12 max-w-2xl mx-auto">
    <!-- Zpět na seznam článků -->
    <a
      href="/blog"
      class="inline-flex items-center gap-1.5 text-xs font-mono text-neutral-400 hover:text-white transition-colors mb-10"
    >
      ← Zpět na všechny články
    </a>

    <!-- Hlavička článku -->
    <header class="mb-10 pb-8 border-b border-neutral-900">
      <div class="flex items-center gap-3 text-xs font-mono text-neutral-400 mb-4">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        {post.data.tags && post.data.tags.length > 0 && (
          <span>• {post.data.tags.join(', ')}</span>
        )}
      </div>

      <h1 class="text-2xl sm:text-3xl sm:leading-snug font-semibold text-white tracking-tight mb-4">
        {post.data.title}
      </h1>

      <p class="text-base text-neutral-400 leading-relaxed">
        {post.data.description}
      </p>
    </header>

    <!-- Samotný obsah článku -->
    <div class="article-content">
      <Content />
    </div>

    <!-- Patička pod článkem -->
    <div class="mt-16 pt-8 border-t border-neutral-900 flex items-center justify-between text-xs font-mono">
      <a
        href="/blog"
        class="text-neutral-400 hover:text-white transition-colors"
      >
        ← Zpět na články
      </a>
      <a
        href="mailto:kontakt@patrikrybka.me"
        class="text-neutral-400 hover:text-white transition-colors"
      >
        Napsat e-mail ↗
      </a>
    </div>
  </article>
</BaseLayout>
