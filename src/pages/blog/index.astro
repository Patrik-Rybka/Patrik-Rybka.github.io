---
// src/pages/blog/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('cs-CZ', {
    day: 'numeric',
    month: 'numeric',
    year: 'numeric',
  }).format(date);
};
---

<BaseLayout 
  title="Blog & Zápisky | Patrik Rybka"
  description="Články a postřehy o programování, technologiích a mých projektech."
>
  <div class="py-12">
    <div class="mb-10">
      <h1 class="text-2xl sm:text-3xl font-semibold text-white tracking-tight">
        Zápisky & Blog
      </h1>
      <p class="text-sm text-neutral-400 mt-2 font-mono">
        Články, poznámky k technologiím a řešení reálných problémů.
      </p>
    </div>

    {posts.length === 0 ? (
      <div class="py-12 text-center font-mono text-xs text-neutral-400">
        Zatím tu nejsou žádné články.
      </div>
    ) : (
      <div class="divide-y divide-neutral-900 border-t border-b border-neutral-900">
        {posts.map((post) => (
          <a
            href={`/blog/${post.id}`}
            class="py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 group block"
          >
            <div>
              <h2 class="text-base font-medium text-white group-hover:underline underline-offset-4 decoration-neutral-600 transition-colors">
                {post.data.title}
              </h2>
              <p class="text-sm text-neutral-400 mt-1 line-clamp-2 max-w-xl">
                {post.data.description}
              </p>
            </div>
            <span class="text-xs font-mono text-neutral-400 whitespace-nowrap sm:text-right">
              {formatDate(post.data.pubDate)}
            </span>
          </a>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
