---
// src/pages/index.astro
import '../styles/global.css';

const portfolioPhotos = [
  {
    title: "Reportáž z letní akce",
    subtitle: "Atmosféra a týmová dynamika v terénu",
    gear: "Canon R10 • 18–150mm • 1/500s",
    imageUrl: "https://images.unsplash.com/photo-1517457373958-b7bdd4587205?auto=format&fit=crop&w=800&q=80",
    alt: "Reportáž z letní akce"
  },
  {
    title: "Portrét na pevnou padesátku",
    subtitle: "Práce s přirozeným světlem a nízkou clonou",
    gear: "Canon R10 • RF 50mm • f/1.8",
    imageUrl: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=800&q=80",
    alt: "Portrét na 50mm objektiv"
  },
  {
    title: "Detail techniky v akci",
    subtitle: "Soustředění na mechanické detaily",
    gear: "Canon R10 • RF 50mm • f/2.2",
    imageUrl: "https://images.unsplash.com/photo-1516035069371-29a1b244cc32?auto=format&fit=crop&w=800&q=80",
    alt: "Detail fotoaparátu a techniky"
  },
  {
    title: "Večerní atmosféra u ohně",
    subtitle: "Focení za nízkého světla bez blesku",
    gear: "Canon R10 • RF 50mm • ISO 3200",
    imageUrl: "https://images.unsplash.com/photo-1478131143081-80f7f84ca84d?auto=format&fit=crop&w=800&q=80",
    alt: "Večerní táborový oheň"
  },
  {
    title: "Moment v pohybu",
    subtitle: "Krátký čas závěrky pro zmrazení akce",
    gear: "Canon R10 • 18–150mm • 1/1000s",
    imageUrl: "https://images.unsplash.com/photo-1526778548025-fa2f459cd5c1?auto=format&fit=crop&w=800&q=80",
    alt: "Dynamická akce v přírodě"
  },
  {
    title: "Ranní plenér a terén",
    subtitle: "Ranní měkké světlo a práce s hloubkou ostrosti",
    gear: "Canon R10 • 18–150mm • f/5.6",
    imageUrl: "https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=800&q=80",
    alt: "Krajina a ranní světlo"
  }
];

const episodes = [
  {
    num: "Díl 1",
    title: "Výběr první bezzrcadlovky a skel",
    subtitle: "Univerzální zoom (18–150 mm) vs. světelná padesátka (f/1.8). Kdy který objektiv nasadit a proč nepotřebuješ hned výbavu za sto tisíc.",
    tag: "VÝBAVA & SKLA",
    readTime: "8 min čtení",
    status: "Číst článek",
    href: "/blog/proc-jsem-si-vytvoril-vlastni-web",
    active: true
  },
  {
    num: "Díl 2",
    title: "Zkrocení expozice v pohybu",
    subtitle: "Reportáž na akcích a táborech bez máznutých a neostrých fotek. Jak nastavit bezpečný čas, clonu a Auto ISO pro nepředvídatelné situace.",
    tag: "PRAXE V TERÉNU",
    readTime: "10 min čtení",
    status: "Připravuje se",
    href: "#",
    active: false
  },
  {
    num: "Díl 3",
    title: "Jak z malého těla dostat použitelné video a čistý zvuk",
    subtitle: "Nastavení Canonu R10 pro video z ruky bez gimbalu. Výběr směrového mikrofonu, řešení větru v plenéru a organizace materiálu na kartách.",
    tag: "VIDEO & AUDIO",
    readTime: "12 min čtení",
    status: "Připravuje se",
    href: "#",
    active: false
  }
];
---

<!doctype html>
<html lang="cs" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>Patrik Rybka – IT, sítě a praktická vizuální tvorba</title>
    <meta name="description" content="Osobní web a technické portfolio Patrika Rybky. Správa sítí, Linux a praktická foto a video reportážní tvorba." />
    <link rel="canonical" href="https://patrikrybka.me" />

    <meta property="og:title" content="Patrik Rybka – IT, sítě a praktická vizuální tvorba" />
    <meta property="og:description" content="Osobní web a technické portfolio Patrika Rybky. Správa sítí, Linux a praktická foto a video tvorba." />
    <meta property="og:url" content="https://patrikrybka.me" />
    <meta property="og:type" content="website" />
  </head>
  <body class="bg-[#0f172a] text-[#f8fafc] antialiased min-h-screen selection:bg-sky-500/30 selection:text-sky-200 font-sans">
    
    <!-- 1. STICKY HEADER & NAVIGACE -->
    <header class="sticky top-0 z-50 w-full bg-[#0f172a]/90 backdrop-blur-md border-b border-slate-800">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href="#" class="text-base font-bold text-white tracking-tight hover:text-sky-400 transition-colors">
          Patrik Rybka
        </a>

        <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-300">
          <a href="#o-mne" class="hover:text-sky-400 transition-colors">O mně</a>
          <a href="#vybava" class="hover:text-sky-400 transition-colors">Výbava</a>
          <a href="#portfolio" class="hover:text-sky-400 transition-colors">Portfolio</a>
          <a href="#navody" class="hover:text-sky-400 transition-colors">Návody & Blog</a>
          <a href="#kontakt" class="hover:text-sky-400 transition-colors">Kontakt</a>
        </nav>

        <a 
          href="#kontakt" 
          class="md:hidden text-xs font-semibold px-3 py-1.5 rounded-lg bg-slate-800 text-sky-400 border border-slate-700"
        >
          Kontakt
        </a>
      </div>
    </header>

    <main class="max-w-5xl mx-auto px-4 sm:px-6">
      
      <!-- 2. HERO SEKCE -->
      <section class="py-16 sm:py-24 border-b border-slate-800">
        <div class="max-w-3xl">
          <span class="inline-block px-3 py-1 text-xs font-mono font-semibold uppercase tracking-wider text-sky-400 bg-sky-950/60 border border-sky-800/60 rounded-md mb-6">
            Technické & tvůrčí portfolio
          </span>

          <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight mb-6">
            Patrik Rybka – IT, sítě a praktická vizuální tvorba
          </h1>

          <p class="text-lg sm:text-xl text-slate-300 leading-relaxed mb-8">
            Jsem student IT se zaměřením na sítě, Linux a hardware. 
            Současně se aktivně věnuji reportážnímu focení a videotvorbě na akcích a táborech, kde propojuji technické zázemí s pohotovým přístupem v terénu.
          </p>

          <div class="flex flex-wrap items-center gap-4">
            <a
              href="#navody"
              class="px-6 py-3 rounded-lg bg-sky-400 hover:bg-sky-300 text-slate-950 font-bold transition-all shadow-md shadow-sky-500/20 text-sm"
            >
              Číst foto průvodce ↓
            </a>
            <a
              href="#portfolio"
              class="px-6 py-3 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-semibold transition-all text-sm"
            >
              Zobrazit portfolio ↓
            </a>
          </div>
        </div>
      </section>

      <!-- 3. SEKCE O MNĚ & VÝBAVA (STACK & GEAR) -->
      <section id="o-mne" class="py-16 sm:py-20 border-b border-slate-800">
        <div class="mb-10 max-w-2xl">
          <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-sky-400 mb-2">
            Profil & zázemí
          </h2>
          <h3 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
            Co dělám a jakou techniku používám
          </h3>
          <p class="text-slate-400 text-base mt-3 leading-relaxed">
            V IT i u fotoaparátu dávám přednost věcnému přístupu: klíčové je rozumět principům fungování techniky, 
            správně ji nakonfigurovat a umět spolehlivě vyřešit problém, ať už sedím u terminálu, nebo stojím uprostřed terénu.
          </p>
        </div>

        <div id="vybava" class="grid grid-cols-1 md:grid-cols-2 gap-6">
          
          <!-- Karta 1: IT & Systémy -->
          <div class="p-6 sm:p-8 rounded-xl bg-slate-900 border border-slate-800 hover:border-slate-700 transition-colors">
            <div class="flex items-center gap-3 mb-6">
              <span class="w-3 h-3 rounded-full bg-sky-400"></span>
              <h4 class="text-lg font-bold text-white">IT & Systémy</h4>
            </div>

            <ul class="space-y-4 text-sm text-slate-300">
              <li class="flex items-start gap-2">
                <span class="text-sky-400 font-mono font-bold">›</span>
                <div>
                  <strong class="text-white block font-semibold">Počítačové sítě</strong>
                  Návrh a správa LAN sítí, směrování, přepínání, diagnostika spojení (TCP/IP, VLAN, DNS, DHCP).
                </div>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-sky-400 font-mono font-bold">›</span>
                <div>
                  <strong class="text-white block font-semibold">Linux & Servery</strong>
                  Běžná administrace distribucí (Debian, Ubuntu), práce v terminálu (Bash), zabezpečení a vzdálená správa přes SSH.
                </div>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-sky-400 font-mono font-bold">›</span>
                <div>
                  <strong class="text-white block font-semibold">Virtualizace & Vývoj</strong>
                  Základy kontejnerizace v Dockeru, virtualizační prostředí, verzování kódu a konfigurací v Gitu.
                </div>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-sky-400 font-mono font-bold">›</span>
                <div>
                  <strong class="text-white block font-semibold">Hardware & Údržba</strong>
                  Stavba a oživování PC stanic, diagnostika závad komponent, správa lokálních záloh a diskových polí.
                </div>
              </li>
            </ul>
          </div>

          <!-- Karta 2: Foto & Video technika -->
          <div class="p-6 sm:p-8 rounded-xl bg-slate-900 border border-slate-800 hover:border-slate-700 transition-colors">
            <div class="flex items-center gap-3 mb-6">
              <span class="w-3 h-3 rounded-full bg-sky-400"></span>
              <h4 class="text-lg font-bold text-white">Foto & Video technika</h4>
            </div>

            <ul class="space-y-4 text-sm text-slate-300">
              <li class="flex items-start gap-2">
                <span class="text-sky-400 font-mono font-bold">›</span>
                <div>
                  <strong class="text-white block font-semibold">Tělo: Canon EOS R10</strong>
                  Lehká a rychlá bezzrcadlovka (APS-C) s přesným Dual Pixel ostřením na oči a spolehlivým sledováním objektů v pohybu.
                </div>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-sky-400 font-mono font-bold">›</span>
                <div>
                  <strong class="text-white block font-semibold">Univerzál: RF-S 18–150mm IS STM</strong>
                  Klíčový reportážní objektiv pro akce a tábory. Zvládne široký celek scény i vzdálený detail bez výměny skla v prachu.
                </div>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-sky-400 font-mono font-bold">›</span>
                <div>
                  <strong class="text-white block font-semibold">Světelné sklo: RF 50mm f/1.8 STM</strong>
                  Pevná padesátka pro portréty, detaily techniky a scény za zhoršeného světla s přirozeným rozostřením pozadí.
                </div>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-sky-400 font-mono font-bold">›</span>
                <div>
                  <strong class="text-white block font-semibold">Příslušenství do terénu</strong>
                  Kompaktní bi-color LED světla, směrový mikrofon s ochranou proti větru (deadcat) a zásoba akumulátorů pro celodenní akce.
                </div>
              </li>
            </ul>
          </div>

        </div>
      </section>

      <!-- 4. SEKCE PORTFOLIO (VIZUÁLNÍ PRÁCE) -->
      <section id="portfolio" class="py-16 sm:py-20 border-b border-slate-800">
        <div class="mb-10">
          <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-sky-400 mb-2">
            Vizuální tvorba
          </h2>
          <h3 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
            Portfolio fotografií
          </h3>
          <p class="text-slate-400 text-base mt-2 max-w-2xl leading-relaxed">
            Ukázky z reportáží, momentek z akcí a práce se světlem. Fotografie lze snadno nahradit vlastními soubory ze složky <code class="text-sky-300 font-mono bg-slate-900 px-1.5 py-0.5 rounded text-xs border border-slate-800">/images/</code>.
          </p>
        </div>

        <!-- 6-Photo Responsive Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {portfolioPhotos.map((photo) => (
            <figure class="group relative rounded-xl overflow-hidden bg-slate-900 border border-slate-800 aspect-[4/3]">
              <img
                src={photo.imageUrl}
                alt={photo.alt}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
              
              <!-- Hover Overlay s popiskem -->
              <figcaption class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/60 to-transparent opacity-90 sm:opacity-0 sm:group-hover:opacity-100 transition-opacity duration-200 p-5 flex flex-col justify-end">
                <span class="text-xs font-mono text-sky-400 font-semibold mb-1">
                  {photo.gear}
                </span>
                <strong class="text-sm font-bold text-white">
                  {photo.title}
                </strong>
                <span class="text-xs text-slate-300 mt-0.5">
                  {photo.subtitle}
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>

      <!-- 5. SEKCE NÁVODY & SERIÁL (BLOG) -->
      <section id="navody" class="py-16 sm:py-20 border-b border-slate-800">
        <div class="mb-8">
          <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-sky-400 mb-2">
            Znalostní báze & seriál
          </h2>
          <h3 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
            Průvodce praktickou fotografií a technikou
          </h3>
        </div>

        <!-- Úvodní box vysvětlující koncept seriálu -->
        <div class="p-6 rounded-xl bg-slate-900 border border-slate-800 mb-10">
          <div class="flex items-start gap-3">
            <span class="text-sky-400 text-xl font-bold font-mono">ℹ</span>
            <div>
              <h4 class="text-base font-bold text-white mb-1">
                Proč píšu tento seriál?
              </h4>
              <p class="text-sm text-slate-300 leading-relaxed">
                Internet je plný recenzí techniky za stovky tisíc, ale v praxi na táboře nebo víkendové akci řešíš úplně jiné věci: 
                jak nezmeškat moment v běhu, jak ochránit techniku v prachu a jak z cenově dostupné sestavy vytěžit maximum. 
                Tento seriál shrnuje mé osobní zkušenosti, chyby a praktické tipy bez zbytečného vyhazování peněz.
              </p>
            </div>
          </div>
        </div>

        <!-- 3 Karty seriálu -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {episodes.map((ep) => (
            <article class="p-6 rounded-xl bg-slate-900 border border-slate-800 flex flex-col justify-between hover:border-slate-700 transition-colors">
              <div>
                <div class="flex items-center justify-between gap-2 mb-3">
                  <span class="text-xs font-mono font-bold text-sky-400">
                    {ep.num}
                  </span>
                  <span class="text-[11px] font-mono text-slate-400 bg-slate-800 px-2 py-0.5 rounded">
                    {ep.readTime}
                  </span>
                </div>

                <span class="inline-block text-[11px] font-mono font-semibold text-slate-400 uppercase tracking-wider mb-2">
                  {ep.tag}
                </span>

                <h4 class="text-base font-bold text-white mb-2 leading-snug">
                  {ep.title}
                </h4>

                <p class="text-xs sm:text-sm text-slate-400 leading-relaxed mb-6">
                  {ep.subtitle}
                </p>
              </div>

              <div>
                {ep.active ? (
                  <a
                    href={ep.href}
                    class="inline-flex items-center gap-1.5 text-xs font-bold text-sky-400 hover:text-sky-300 transition-colors"
                  >
                    {ep.status} →
                  </a>
                ) : (
                  <span class="inline-block text-xs font-mono text-slate-500 py-1">
                    [ {ep.status} ]
                  </span>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- 6. KONTAKT -->
      <section id="kontakt" class="py-16 sm:py-20">
        <div class="max-w-2xl">
          <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-sky-400 mb-2">
            Kontakt
          </h2>
          <h3 class="text-2xl sm:text-3xl font-bold text-white tracking-tight mb-4">
            Pojďme se spojit
          </h3>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-8">
            Hledáš někoho na focení či video z vaší akce, nebo chceš probrat správu sítí a technické záležitosti? 
            Napiš mi e-mail nebo se ozvi přes GitHub.
          </p>

          <div class="flex flex-wrap items-center gap-4 text-sm font-mono">
            <a
              href="mailto:kontakt@patrikrybka.me"
              class="inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-sky-400 hover:bg-sky-300 text-slate-950 font-bold transition-colors"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              kontakt@patrikrybka.me
            </a>

            <a
              href="https://github.com/Patrik-Rybka"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-800 font-semibold transition-colors"
            >
              GitHub profil ↗
            </a>
          </div>
        </div>
      </section>

    </main>

    <!-- PATIČKA -->
    <footer class="w-full border-t border-slate-800 bg-[#0b1120] py-8">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-slate-400">
        <div>
          © 2026 Patrik Rybka • Běží na GitHub Pages
        </div>
        <div class="flex items-center gap-4">
          <a href="#o-mne" class="hover:text-slate-200 transition-colors">O mně</a>
          <span>•</span>
          <a href="#portfolio" class="hover:text-slate-200 transition-colors">Portfolio</a>
          <span>•</span>
          <a href="#navody" class="hover:text-slate-200 transition-colors">Návody</a>
          <span>•</span>
          <a href="#kontakt" class="hover:text-slate-200 transition-colors">Kontakt</a>
        </div>
      </div>
    </footer>

  </body>
</html>
