---
// src/pages/index.astro
import homepageData from '../content/homepage/index.json';
---

<!doctype html>
<html lang="cs" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>Patrik Rybka — IT, sítě & terénní foto</title>
    <meta name="description" content="Student 3. ročníku IT na Úžlabině. Zájem o sítě, servery a hardware. Terénní foto a videotvorba s Canonem R10 na táborech a akcích." />
    <link rel="canonical" href="https://patrikrybka.me" />

    <meta property="og:title" content="Patrik Rybka — IT, sítě & terénní foto" />
    <meta property="og:description" content="Student 3. ročníku IT na Úžlabině. Zájem o sítě, servery a hardware. Terénní foto a videotvorba s Canonem R10 na táborech a akcích." />
    <meta property="og:url" content="https://patrikrybka.me" />
    <meta property="og:type" content="website" />

    <style is:inline>
      /* --- DESIGN SYSTEM: EDITORIAL GRAPHITE WITH FLUID MICRO-INTERACTIONS --- */
      :root {
        /* Hluboká grafitová paleta s prostorovým osvětlením */
        --bg: #111216;
        --bg-deep: #0b0c0e;
        --surface: #171820;
        --surface-raised: #1c1d27;
        --surface-hover: #222432;
        --border: rgba(255, 255, 255, 0.08);
        --border-subtle: rgba(255, 255, 255, 0.04);
        --border-active: rgba(255, 255, 255, 0.22);
        
        --text: #f4f4f7;
        --text-muted: #9fa3b2;
        --text-dim: #65697a;
        
        --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }

      /* Elegantní tmavý scrollbar */
      ::-webkit-scrollbar {
        width: 8px;
      }
      ::-webkit-scrollbar-track {
        background: #0d0e12;
      }
      ::-webkit-scrollbar-thumb {
        background: #232530;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #363949;
      }

      html {
        background-color: var(--bg);
        color: var(--text);
        font-family: var(--font-sans);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      body {
        min-height: 100vh;
        overflow-x: hidden;
        /* Bohaté vícevrstvé grafitové pozadí s prostorovým světlem */
        background-color: var(--bg);
        background-image: 
          radial-gradient(ellipse 90% 60% at 50% -10%, rgba(65, 75, 95, 0.18), transparent 75%),
          radial-gradient(ellipse 60% 40% at 85% 45%, rgba(45, 50, 70, 0.14), transparent 70%),
          radial-gradient(ellipse 70% 50% at 15% 85%, rgba(40, 45, 60, 0.16), transparent 75%);
        background-attachment: fixed;
      }

      .container {
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      .mono {
        font-family: var(--font-mono);
      }

      /* Animace načtení pro úvodní prvky */
      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(22px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* --- PLOVOUCÍ NAVIGAČNÍ DOK (Webflow styl) --- */
      .nav-dock-wrapper {
        position: fixed;
        top: 1.5rem;
        left: 0;
        right: 0;
        z-index: 1000;
        display: flex;
        justify-content: center;
        padding: 0 1rem;
        pointer-events: none;
      }

      .nav-dock {
        pointer-events: auto;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        padding: 0.6rem 1.4rem;
        background: rgba(22, 23, 30, 0.78);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 9999px;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.5), 0 0 1px rgba(255, 255, 255, 0.15);
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease, border-color 0.3s ease;
      }

      .nav-dock:hover {
        border-color: rgba(255, 255, 255, 0.2);
        box-shadow: 0 16px 42px rgba(0, 0, 0, 0.6), 0 0 20px rgba(255, 255, 255, 0.03);
      }

      .dock-brand {
        font-weight: 700;
        font-size: 0.95rem;
        color: #fff;
        text-decoration: none;
        letter-spacing: -0.02em;
        margin-right: 0.5rem;
        transition: opacity 0.2s;
      }

      .dock-brand:hover {
        opacity: 0.85;
      }

      .dock-links {
        display: flex;
        gap: 0.35rem;
        font-size: 0.85rem;
        font-weight: 500;
      }

      .dock-links a {
        color: var(--text-muted);
        text-decoration: none;
        padding: 0.35rem 0.75rem;
        border-radius: 9999px;
        transition: color 0.2s ease, background-color 0.2s ease;
      }

      .dock-links a:hover {
        color: #ffffff;
        background-color: rgba(255, 255, 255, 0.08);
      }

      /* --- HERO SEKCE --- */
      .hero-section {
        padding: 8rem 0 5rem;
        position: relative;
      }

      .hero-grid {
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
        gap: 4rem;
        align-items: center;
      }

      .hero-text {
        animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }

      .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.8rem;
        font-family: var(--font-mono);
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: var(--text-dim);
        margin-bottom: 1.25rem;
      }

      .hero-title {
        font-size: clamp(3rem, 7vw, 5.25rem);
        font-weight: 900;
        letter-spacing: -0.04em;
        line-height: 0.98;
        color: #fff;
        margin-bottom: 1.5rem;
        text-transform: uppercase;
      }

      .hero-title .outline {
        color: transparent;
        -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.4);
        transition: -webkit-text-stroke 0.3s ease;
      }

      .hero-title:hover .outline {
        -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.85);
      }

      .hero-desc {
        font-size: 1.125rem;
        color: var(--text-muted);
        line-height: 1.65;
        max-width: 530px;
        margin-bottom: 2.25rem;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
        align-items: center;
      }

      .btn-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.85rem 1.65rem;
        border-radius: 9999px;
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease, background-color 0.2s ease, border-color 0.2s ease;
      }

      .btn-pill:hover {
        transform: translateY(-2px);
      }

      .btn-pill:active {
        transform: translateY(0) scale(0.98);
      }

      .btn-white {
        background: #ffffff;
        color: #0b0c0e;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
      }

      .btn-white:hover {
        background: #f0f0f4;
        box-shadow: 0 10px 25px -4px rgba(255, 255, 255, 0.25);
      }

      .btn-ghost {
        background: rgba(255, 255, 255, 0.05);
        color: #ffffff;
        border: 1px solid var(--border);
      }

      .btn-ghost:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: var(--border-active);
        box-shadow: 0 10px 25px -4px rgba(0, 0, 0, 0.5);
      }

      /* Hero Visual Banner (Plakát) */
      .hero-visual-card {
        position: relative;
        border-radius: 14px;
        overflow: hidden;
        aspect-ratio: 4 / 5;
        background: var(--surface);
        border: 1px solid var(--border);
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.65);
        animation: fadeInUp 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease;
      }

      .hero-visual-card:hover {
        transform: translateY(-4px);
        border-color: rgba(255, 255, 255, 0.2);
        box-shadow: 0 40px 80px -10px rgba(0, 0, 0, 0.8), 0 0 35px rgba(255, 255, 255, 0.04);
      }

      .hero-visual-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 20%;
        display: block;
        filter: contrast(105%);
        transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1), filter 0.4s ease;
      }

      .hero-visual-card:hover img {
        transform: scale(1.045);
        filter: contrast(108%);
      }

      .hero-visual-badge {
        position: absolute;
        bottom: 1.25rem;
        left: 1.25rem;
        right: 1.25rem;
        padding: 0.85rem 1.25rem;
        background: rgba(17, 18, 24, 0.86);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid var(--border);
        border-radius: 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.75rem;
        font-family: var(--font-mono);
        color: var(--text-muted);
        transition: background-color 0.3s ease, border-color 0.3s ease;
      }

      .hero-visual-card:hover .hero-visual-badge {
        background: rgba(20, 22, 30, 0.92);
        border-color: rgba(255, 255, 255, 0.18);
      }

      .hero-visual-badge strong {
        color: #ffffff;
        font-weight: 600;
      }

      /* Rychlé statistiky / pilíře */
      .stats-strip {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
        padding: 3rem 0;
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        margin: 3rem 0 6rem;
        animation: fadeInUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.3s both;
      }

      .stat-item {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        padding: 0.5rem 0;
        transition: transform 0.25s ease;
      }

      .stat-item:hover {
        transform: translateY(-2px);
      }

      .stat-num {
        font-size: 1.5rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        color: #ffffff;
        transition: text-shadow 0.25s ease;
      }

      .stat-item:hover .stat-num {
        text-shadow: 0 0 20px rgba(255, 255, 255, 0.25);
      }

      .stat-label {
        font-size: 0.85rem;
        color: var(--text-dim);
        font-family: var(--font-mono);
      }

      /* Nadpisy sekcí */
      .section-heading-wrap {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 3.5rem;
        flex-wrap: wrap;
        gap: 1.5rem;
      }

      .section-title {
        font-size: clamp(1.75rem, 4vw, 2.5rem);
        font-weight: 800;
        letter-spacing: -0.03em;
        color: #ffffff;
      }

      .section-subtitle {
        font-size: 0.95rem;
        color: var(--text-muted);
        max-width: 520px;
        line-height: 1.6;
      }

      /* --- O MNĚ & TECHNIKA (Kreativní Split bez rámečkových štítků) --- */
      .split-section {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3.5rem;
        margin-bottom: 3.5rem;
      }

      .split-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 2.75rem;
        box-shadow: 0 16px 36px -10px rgba(0, 0, 0, 0.45);
        transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, box-shadow 0.35s ease, background-color 0.3s ease;
      }

      .split-card:hover {
        transform: translateY(-5px);
        background: var(--surface-hover);
        border-color: var(--border-active);
        box-shadow: 0 24px 50px -10px rgba(0, 0, 0, 0.65), 0 0 25px rgba(255, 255, 255, 0.02);
      }

      .card-tag {
        font-size: 0.75rem;
        font-family: var(--font-mono);
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--text-dim);
        margin-bottom: 1rem;
      }

      .card-headline {
        font-size: 1.5rem;
        font-weight: 700;
        color: #ffffff;
        letter-spacing: -0.02em;
        margin-bottom: 1.25rem;
      }

      .card-copy {
        color: var(--text-muted);
        font-size: 0.98rem;
        line-height: 1.75;
      }

      /* --- KARIÉRNÍ STRIP (CV Focus & Uplatnění) --- */
      .career-strip {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 2.75rem;
        margin-bottom: 7rem;
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
        gap: 3.5rem;
        box-shadow: 0 16px 36px -10px rgba(0, 0, 0, 0.45);
        transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, box-shadow 0.35s ease;
      }

      .career-strip:hover {
        transform: translateY(-4px);
        border-color: var(--border-active);
        box-shadow: 0 24px 50px -10px rgba(0, 0, 0, 0.65);
      }

      .career-label {
        display: inline-block;
        font-size: 0.75rem;
        font-family: var(--font-mono);
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--text-dim);
        margin-bottom: 0.75rem;
      }

      .career-title {
        font-size: 1.4rem;
        font-weight: 700;
        color: #ffffff;
        letter-spacing: -0.02em;
        margin-bottom: 1rem;
      }

      .career-text {
        color: var(--text-muted);
        font-size: 0.96rem;
        line-height: 1.75;
      }

      .career-text strong {
        color: #ffffff;
        font-weight: 600;
      }

      .career-skills {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        justify-content: center;
      }

      .skill-category {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        padding-left: 1.1rem;
        border-left: 2px solid rgba(255, 255, 255, 0.18);
      }

      .skill-cat-title {
        font-size: 0.8rem;
        font-family: var(--font-mono);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #ffffff;
        font-weight: 600;
      }

      .skill-cat-list {
        font-size: 0.88rem;
        color: var(--text-muted);
        line-height: 1.5;
      }

      /* --- MAGAZÍNOVÁ FOTOGALERIE --- */
      .gallery-container {
        margin-bottom: 7rem;
      }

      .magazine-mosaic {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 1.25rem;
      }

      .mosaic-item {
        position: relative;
        border-radius: 12px;
        overflow: hidden;
        background: var(--surface);
        border: 1px solid var(--border);
        box-shadow: 0 16px 32px -8px rgba(0, 0, 0, 0.5);
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, box-shadow 0.4s ease;
      }

      .mosaic-item:hover {
        transform: translateY(-4px);
        border-color: rgba(255, 255, 255, 0.22);
        box-shadow: 0 28px 56px -10px rgba(0, 0, 0, 0.75);
      }

      .mosaic-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1), filter 0.4s ease;
        filter: brightness(0.92);
      }

      .mosaic-item:hover img {
        transform: scale(1.045);
        filter: brightness(1.02) contrast(105%);
      }

      .mosaic-info {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(14, 15, 20, 0.94) 0%, rgba(14, 15, 20, 0.35) 60%, transparent 100%);
        padding: 1.75rem;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        opacity: 0;
        transform: translateY(10px);
        transition: opacity 0.3s ease, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        pointer-events: none;
      }

      .mosaic-item:hover .mosaic-info {
        opacity: 1;
        transform: translateY(0);
      }

      .mosaic-info h4 {
        font-size: 1.1rem;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 0.25rem;
      }

      .mosaic-info p {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-bottom: 0.65rem;
      }

      .mosaic-exif {
        display: inline-block;
        font-size: 0.75rem;
        font-family: var(--font-mono);
        color: #ffffff;
        background: rgba(255, 255, 255, 0.1);
        padding: 0.25rem 0.6rem;
        border-radius: 4px;
        backdrop-filter: blur(8px);
        align-self: flex-start;
      }

      .span-12 { grid-column: span 12; aspect-ratio: 21 / 9; }
      .span-7  { grid-column: span 7; aspect-ratio: 16 / 10; }
      .span-5  { grid-column: span 5; aspect-ratio: 4 / 5; }
      .span-6  { grid-column: span 6; aspect-ratio: 16 / 10; }

      /* --- NÁVODY & ZÁPISKY (Editorial List) --- */
      .series-section {
        margin-bottom: 7rem;
      }

      .series-stack {
        display: flex;
        flex-direction: column;
        border-top: 1px solid var(--border);
      }

      .series-entry {
        display: grid;
        grid-template-columns: 4rem 1fr auto;
        gap: 2rem;
        align-items: center;
        padding: 2.25rem 1.25rem;
        border-bottom: 1px solid var(--border);
        text-decoration: none;
        color: inherit;
        border-radius: 10px;
        transition: background-color 0.25s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease;
      }

      .series-entry:hover {
        background-color: var(--surface);
        transform: translateX(8px);
        border-color: rgba(255, 255, 255, 0.16);
      }

      .series-number {
        font-size: 2.25rem;
        font-weight: 900;
        letter-spacing: -0.04em;
        color: rgba(255, 255, 255, 0.2);
        font-family: var(--font-mono);
        transition: color 0.25s ease, transform 0.25s ease;
      }

      .series-entry:hover .series-number {
        color: #ffffff;
        transform: scale(1.05);
      }

      .series-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 0.35rem;
        letter-spacing: -0.01em;
        transition: color 0.2s ease;
      }

      .series-text {
        font-size: 0.95rem;
        color: var(--text-muted);
        line-height: 1.55;
        max-width: 640px;
      }

      .series-badge {
        font-size: 0.85rem;
        font-family: var(--font-mono);
        color: #ffffff;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s;
      }

      .series-entry:hover .series-badge {
        transform: translateX(4px);
        color: #ffffff;
      }

      /* --- KONTAKT SE prostorovým osvětlením --- */
      .contact-banner {
        background: linear-gradient(180deg, var(--surface) 0%, rgba(20, 21, 28, 0.6) 100%);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 4rem 3.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 2.5rem;
        margin-bottom: 5rem;
        box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.55);
        transition: transform 0.35s ease, border-color 0.3s ease, box-shadow 0.35s ease;
      }

      .contact-banner:hover {
        transform: translateY(-3px);
        border-color: rgba(255, 255, 255, 0.18);
        box-shadow: 0 30px 65px -15px rgba(0, 0, 0, 0.7);
      }

      .contact-lead-text h2 {
        font-size: 2.25rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        color: #ffffff;
        margin-bottom: 0.75rem;
      }

      .contact-lead-text p {
        font-size: 1.05rem;
        color: var(--text-muted);
        max-width: 500px;
      }

      .contact-cta-group {
        display: flex;
        gap: 0.85rem;
        flex-wrap: wrap;
      }

      /* --- FOOTER --- */
      footer {
        padding: 2.5rem 0;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        font-size: 0.8rem;
        font-family: var(--font-mono);
        color: var(--text-dim);
      }

      /* --- RESPONZIVNÍ BREAKPOINTY --- */
      @media (max-width: 900px) {
        .hero-grid {
          grid-template-columns: 1fr;
          gap: 3rem;
        }
        .hero-visual-card {
          aspect-ratio: 16 / 10;
        }
        .split-section {
          grid-template-columns: 1fr;
          gap: 2rem;
          margin-bottom: 2rem;
        }
        .career-strip {
          grid-template-columns: 1fr;
          gap: 2rem;
          padding: 2rem 1.5rem;
          margin-bottom: 5rem;
        }
        .stats-strip {
          grid-template-columns: 1fr;
          gap: 1.5rem;
        }
        .magazine-mosaic {
          grid-template-columns: 1fr;
        }
        .span-12, .span-7, .span-5, .span-6 {
          grid-column: span 1;
          aspect-ratio: 16 / 10;
        }
        .mosaic-info {
          opacity: 1;
          transform: translateY(0);
        }
        .series-entry {
          grid-template-columns: 2.5rem 1fr;
          gap: 1.25rem;
        }
        .series-badge {
          grid-column: 2;
        }
        .contact-banner {
          padding: 2.5rem 1.75rem;
        }
        .dock-links {
          display: none;
        }
      }
    </style>
  </head>
  <body>

    <!-- Plovoucí navigační dok -->
    <div class="nav-dock-wrapper">
      <nav class="nav-dock">
        <a href="#" class="dock-brand">Patrik Rybka</a>
        <div class="dock-links">
          <a href="#o-mne">O mně</a>
          <a href="#vybava">Výbava & CV</a>
          <a href="#fotky">Fotky</a>
          <a href="#zapisky">Zápisky</a>
          <a href="#kontakt">Kontakt</a>
        </div>
      </nav>
    </div>

    <div class="container">
      
      <!-- HERO SEKCE -->
      <section class="hero-section">
        <div class="hero-grid">
          
          <div class="hero-text">
            <span class="hero-eyebrow">
              {homepageData.heroEyebrow}
            </span>

            <h1 class="hero-title">
              Patrik<br />
              <span class="outline">Rybka</span>
            </h1>

            <p class="hero-desc">
              {homepageData.heroDesc}
            </p>

            <div class="hero-actions">
              <a href="#o-mne" class="btn-pill btn-white">
                Co umím & CV ↓
              </a>
              <a href="#kontakt" class="btn-pill btn-ghost">
                Napsat zprávu →
              </a>
            </div>
          </div>

          <!-- Hero plakátová kotva (Ostrý studiový portrét) -->
          <div class="hero-visual-card">
            <img 
              src="/images/patrik-portrait.jpg" 
              alt="Patrik Rybka" 
              loading="eager"
            />
            <div class="hero-visual-badge">
              <span><strong>PATRIK RYBKA</strong> • TÁBORY & VLASTNÍ TVORBA</span>
              <span>CANON R10 · 2026</span>
            </div>
          </div>

        </div>
      </section>

      <!-- METRIKY & PILÍŘE -->
      <section class="stats-strip">
        <div class="stat-item">
          <span class="stat-num">Úžlabina → FIT/VUT</span>
          <span class="stat-label">IT gympl • sítě, kyberbezpečnost</span>
        </div>
        <div class="stat-item">
          <span class="stat-num">Sítě & Virtualizace</span>
          <span class="stat-label">VirtualBox laby • Linux • síťový hardware</span>
        </div>
        <div class="stat-item">
          <span class="stat-num">Canon EOS R10</span>
          <span class="stat-label">Reportáže • tábory • postprodukce</span>
        </div>
      </section>

      <!-- O MNĚ & TECHNIKA (Bez škatulkovacích štítků) -->
      <section id="o-mne">
        <div class="section-heading-wrap">
          <div>
            <h2 class="section-title">O mně & Technika</h2>
            <p class="section-subtitle">
              Zájem o hardware a sítě, moderní kódování a focení v terénu.
            </p>
          </div>
        </div>

        <div class="split-section" id="vybava">
          
          <!-- Levý sloupec: IT -->
          <div class="split-card">
            <div class="card-tag">IT & VÝVOJ</div>
            <h3 class="card-headline">{homepageData.aboutSystemsHeadline}</h3>
            <p class="card-copy">
              {homepageData.aboutSystemsCopy}
            </p>
          </div>

          <!-- Pravý sloupec: Foto -->
          <div class="split-card">
            <div class="card-tag">FOTO VÝBAVA</div>
            <h3 class="card-headline">{homepageData.aboutGearHeadline}</h3>
            <p class="card-copy">
              {homepageData.aboutGearCopy}
            </p>
          </div>

        </div>

        <!-- KARIÉRNÍ STRIP (CV Focus & Uplatnění) -->
        <div class="career-strip">
          <div class="career-focus">
            <span class="career-label">UPLATNĚNÍ & BRIGÁDA</span>
            <h4 class="career-title">Co mohu nabídnout & co hledám</h4>
            <p class="career-text">
              Otevřen studentským stážím, brigádám a juniorním pozicím: <strong>správa a konfigurace sítí, L1/L2 technická podpora, správa Linuxových stanic/serverů</strong> a hardware servis. Pro tábory a eventy nabízím <strong>kompletní reportážní foto/video servis</strong> včetně rychlé postprodukce.
            </p>
          </div>
          <div class="career-skills">
            <div class="skill-category">
              <span class="skill-cat-title">Sítě & Systémy</span>
              <p class="skill-cat-list">Linux (Debian, Ubuntu), VirtualBox, TCP/IP, VLAN, směrování, kyberbezpečnost</p>
            </div>
            <div class="skill-category">
              <span class="skill-cat-title">Vývoj & Nástroje</span>
              <p class="skill-cat-list">Git, GitHub, Bash, HTML/CSS, Astro, moderní AI vývojové workflow</p>
            </div>
            <div class="skill-category">
              <span class="skill-cat-title">Foto & Postprodukce</span>
              <p class="skill-cat-list">Canon EOS R10, DaVinci Resolve Studio, Adobe Lightroom, Photoshop</p>
            </div>
          </div>
        </div>
      </section>

      <!-- FOTOGRAFICKÉ PORTFOLIO -->
      <section id="fotky" class="gallery-container">
        <div class="section-heading-wrap">
          <div>
            <h2 class="section-title">Fotky</h2>
            <p class="section-subtitle">
              Momentky z táborů, sport v běhu i fotky, co cvakám jen tak pro sebe.
            </p>
          </div>
        </div>

        <div class="magazine-mosaic">
          
          <!-- 1. Velká širokoúhlá dominanta -->
          <div class="mosaic-item span-12">
            <img 
              src="https://images.unsplash.com/photo-1517457373958-b7bdd4587205?auto=format&fit=crop&w=1500&q=80" 
              alt="Momentka z letní akce" 
              loading="lazy"
            />
            <div class="mosaic-info">
              <h4>Momentka z akce</h4>
              <p>Týmová energie, dění a atmosféra v plenéru</p>
              <span class="mosaic-exif">18–150 mm · 1/500s · f/4.5</span>
            </div>
          </div>

          <!-- 2. Vertikální portrét / Autentický terén s Canonem -->
          <div class="mosaic-item span-5">
            <img 
              src="/images/patrik-field.jpg" 
              alt="Patrik v terénu s Canonem R10" 
              loading="lazy"
              style="object-position: center 25%;"
            />
            <div class="mosaic-info">
              <h4>Patrik v terénu</h4>
              <p>S bezzrcadlovkou Canon R10 na výjezdu</p>
              <span class="mosaic-exif">Canon EOS R10 · 18–150 mm</span>
            </div>
          </div>

          <!-- 3. Širokoúhlejší záběr -->
          <div class="mosaic-item span-7">
            <img 
              src="https://images.unsplash.com/photo-1478131143081-80f7f84ca84d?auto=format&fit=crop&w=1000&q=80" 
              alt="Večerní atmosféra u táboráku" 
              loading="lazy"
            />
            <div class="mosaic-info">
              <h4>Večerní atmosféra u táboráku</h4>
              <p>Focení za šera bez umělého blesku</p>
              <span class="mosaic-exif">RF 50 mm · f/1.8 · ISO 3200</span>
            </div>
          </div>

          <!-- 4. Moment v pohybu -->
          <div class="mosaic-item span-6">
            <img 
              src="https://images.unsplash.com/photo-1526778548025-fa2f459cd5c1?auto=format&fit=crop&w=900&q=80" 
              alt="Sport v běhu" 
              loading="lazy"
            />
            <div class="mosaic-info">
              <h4>Sport v běhu</h4>
              <p>Pohotová reakce a krátký čas závěrky</p>
              <span class="mosaic-exif">18–150 mm · 1/1000s</span>
            </div>
          </div>

          <!-- 5. Detail techniky / Filtry -->
          <div class="mosaic-item span-6">
            <img 
              src="https://images.unsplash.com/photo-1516035069371-29a1b244cc32?auto=format&fit=crop&w=900&q=80" 
              alt="Práce se světlem a filtry" 
              loading="lazy"
            />
            <div class="mosaic-info">
              <h4>Práce se světlem a filtry</h4>
              <p>CPL, ND a difuzní filtr na bezzrcadlovce</p>
              <span class="mosaic-exif">RF 50 mm · f/2.2</span>
            </div>
          </div>

        </div>
      </section>

      <!-- SERIÁL & ZÁPISKY (Publikované články bez staveniště) -->
      <section id="zapisky" class="series-section">
        <div class="section-heading-wrap">
          <div>
            <h2 class="section-title">Zápisky</h2>
            <p class="section-subtitle">
              Praktické poznámky k technice, nastavení bezzrcadlovky a focení v pohybu.
            </p>
          </div>
        </div>

        <div class="series-stack">
          
          <a href="/blog/jak-nastavit-canon-r10-na-sport-a-pohyb" class="series-entry">
            <span class="series-number">01</span>
            <div>
              <h3 class="series-title">Jak nastavit Canon R10 na sport a pohyb, aby nebyly fotky máznuté</h3>
              <p class="series-text">
                Praktické nastavení času závěrky, autofokusu se sledováním očí a Auto ISO pro akce a tábory plné rychlého pohybu.
              </p>
            </div>
            <div class="series-badge">Číst článek →</div>
          </a>

          <a href="/blog/proc-jsem-si-vytvoril-vlastni-web" class="series-entry">
            <span class="series-number">02</span>
            <div>
              <h3 class="series-title">Proč jsem si jako student IT vytvořil vlastní web a blog</h3>
              <p class="series-text">
                Důvody pro spuštění osobního portfolia, volba moderního stacku Astro na GitHub Pages a proč psaní článků pomáhá v učení.
              </p>
            </div>
            <div class="series-badge">Číst článek →</div>
          </a>

          <div class="series-entry" style="cursor: default;">
            <span class="series-number">03</span>
            <div>
              <h3 class="series-title">Filtry v praxi: polarizák, ND a difuzní filtr na malé bezzrcadlovce</h3>
              <p class="series-text">
                Kdy točit CPL proti odleskům na vodě, proč mít ND na video na ostrém slunci a jak funguje difuzní filtr.
              </p>
            </div>
            <div class="series-badge" style="color: var(--text-dim);">[ Připravuje se ]</div>
          </div>

        </div>
      </section>

      <!-- KONTAKT -->
      <section id="kontakt" class="contact-banner">
        <div class="contact-lead-text">
          <h2>{homepageData.contactHeadline}</h2>
          <p>
            {homepageData.contactCopy}
          </p>
        </div>

        <div class="contact-cta-group">
          <a href={`mailto:${homepageData.contactEmail}`} class="btn-pill btn-white">
            {homepageData.contactEmail} ↗
          </a>
          <a href={homepageData.contactGithub} target="_blank" rel="noopener noreferrer" class="btn-pill btn-ghost">
            GitHub ↗
          </a>
          {homepageData.contactInstagram && (
            <a href={homepageData.contactInstagram} target="_blank" rel="noopener noreferrer" class="btn-pill btn-ghost">
              Instagram ↗
            </a>
          )}
          {homepageData.contactLinkedin && (
            <a href={homepageData.contactLinkedin} target="_blank" rel="noopener noreferrer" class="btn-pill btn-ghost">
              LinkedIn ↗
            </a>
          )}
        </div>
      </section>

      <!-- PATIČKA -->
      <footer>
        <div>© 2026 Patrik Rybka • Úžlabina</div>
        <div>patrikrybka.me</div>
      </footer>

    </div>
  </body>
</html>
