---
// src/components/Hero.astro
---

<section class="py-12 sm:py-20">
  <!-- Status badge -->
  <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 mb-6">
    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
    Student IT • Otevřený novým příležitostem
  </div>

  <!-- Hlavní nadpis -->
  <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white mb-6">
    Ahoj, jsem <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-cyan-400">Patrik Rybka</span>.
  </h1>

  <!-- Úvodní popis -->
  <p class="text-lg sm:text-xl text-neutral-300 max-w-2xl leading-relaxed mb-8">
    Jsem student IT se zájmem o vývoj softwaru, webové technologie a moderní nástroje. 
    Baví mě zkoumat, jak věci fungují pod kapotou, psát čistý kód a tvořit smysluplné projekty.
  </p>

  <!-- Akční tlačítka -->
  <div class="flex flex-wrap items-center gap-4">
    <a
      href="#projekty"
      class="px-5 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-medium shadow-lg shadow-indigo-600/25 transition-all duration-200"
    >
      Moje projekty
    </a>
    <a
      href="#kontakt"
      class="px-5 py-3 rounded-xl bg-neutral-900 hover:bg-neutral-800 text-neutral-200 font-medium border border-neutral-800 transition-all duration-200"
    >
      Kontaktovat mě
    </a>
  </div>
</section>
