---
// src/components/ProjectCard.astro

interface Props {
  title: string;
  description: string;
  tags: string[];
  githubUrl?: string;
  liveUrl?: string;
}

const { title, description, tags, githubUrl, liveUrl } = Astro.props;
---

<div class="flex flex-col justify-between p-6 rounded-2xl bg-neutral-900/40 border border-neutral-800/80 hover:border-neutral-700/80 transition-all group">
  <div>
    <!-- Štítky technologií -->
    <div class="flex flex-wrap gap-1.5 mb-4">
      {tags.map((tag) => (
        <span class="px-2.5 py-0.5 rounded-md text-xs font-medium bg-neutral-800/80 text-neutral-300">
          {tag}
        </span>
      ))}
    </div>

    <!-- Název projektu -->
    <h3 class="text-xl font-bold text-white group-hover:text-indigo-400 transition-colors mb-2">
      {title}
    </h3>

    <!-- Popis -->
    <p class="text-neutral-400 text-sm leading-relaxed mb-6">
      {description}
    </p>
  </div>

  <!-- Odkazy -->
  <div class="flex items-center gap-3 pt-4 border-t border-neutral-800/60 text-sm">
    {githubUrl && (
      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-neutral-300 hover:text-white transition-colors"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        GitHub
      </a>
    )}

    {liveUrl && (
      <a
        href={liveUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-indigo-400 hover:text-indigo-300 transition-colors ml-auto font-medium"
      >
        Živá ukázka
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    )}
  </div>
</div>
