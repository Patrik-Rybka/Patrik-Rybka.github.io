---
// src/components/ProjectCard.astro

interface Props {
  title: string;
  description: string;
  tags: string[];
  githubUrl?: string;
  liveUrl?: string;
}

const { title, description, tags, githubUrl, liveUrl } = Astro.props;
---

<div class="py-6 border-b border-neutral-900 last:border-none group">
  <div class="flex items-start justify-between gap-4 mb-2">
    <h3 class="text-base font-medium text-white">
      {liveUrl ? (
        <a 
          href={liveUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center gap-1.5 hover:text-neutral-300 transition-colors"
        >
          {title}
          <span class="text-xs text-neutral-400 group-hover:text-white transition-colors">↗</span>
        </a>
      ) : (
        <span>{title}</span>
      )}
    </h3>

    <div class="flex items-center gap-3 text-xs font-mono text-neutral-400">
      {githubUrl && (
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-white transition-colors"
        >
          GitHub ↗
        </a>
      )}
    </div>
  </div>

  <p class="text-sm text-neutral-400 leading-relaxed mb-3 max-w-2xl">
    {description}
  </p>

  <div class="text-xs font-mono text-neutral-400">
    {tags.join(" · ")}
  </div>
</div>
