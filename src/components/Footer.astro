---
const currentYear = new Date().getFullYear();

const socialLinks = [
  { name: 'GitHub', href: 'https://github.com/Patrik-Rybka' },
  { name: 'LinkedIn', href: 'https://linkedin.com' },
  { name: 'E-mail', href: 'mailto:kontakt@patrikrybka.me' },
];
---

<footer class="w-full border-t border-neutral-800/80 bg-neutral-950 mt-auto">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-neutral-400">
    <!-- Copyright & Stack info -->
    <div class="flex flex-col sm:flex-row items-center gap-1 sm:gap-3 text-center sm:text-left">
      <span>© {currentYear} Patrik Rybka</span>
      <span class="hidden sm:inline text-neutral-600">•</span>
      <span class="text-neutral-500 text-xs sm:text-sm">Vytvořeno v Astro & Tailwind CSS</span>
    </div>

    <!-- Sociální sítě & kontakt -->
    <div class="flex items-center gap-4">
      {socialLinks.map((link) => (
        <a
          href={link.href}
          target={link.href.startsWith('http') ? '_blank' : undefined}
          rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="hover:text-white transition-colors"
        >
          {link.name}
        </a>
      ))}
    </div>
  </div>
</footer>
