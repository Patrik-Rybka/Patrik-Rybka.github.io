---
// src/components/Contact.astro
---

<section id="kontakt" class="py-12 border-t border-neutral-800/60">
  <div class="max-w-xl">
    <span class="text-xs font-semibold uppercase tracking-wider text-indigo-400">Kontakt</span>
    <h2 class="text-2xl sm:text-3xl font-bold text-white mt-1">Pojďme se spojit</h2>
    <p class="text-neutral-400 mt-2 text-sm sm:text-base leading-relaxed">
      Máš dotaz, nápad na projekt, nebo zájem o spolupráci? Napiš mi e-mail nebo se ozvi na GitHubu.
    </p>

    <div class="mt-6 flex flex-wrap items-center gap-4">
      <a
        href="mailto:kontakt@patrikrybka.me"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-medium shadow-lg shadow-indigo-600/20 transition-all text-sm"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        kontakt@patrikrybka.me
      </a>

      <a
        href="https://github.com/Patrik-Rybka"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-neutral-900 hover:bg-neutral-800 text-neutral-200 font-medium border border-neutral-800 transition-all text-sm"
      >
        GitHub profil
      </a>
    </div>
  </div>
</section>
