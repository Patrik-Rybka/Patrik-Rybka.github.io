---
// src/components/Contact.astro
---

<section id="kontakt" class="py-12 border-t border-neutral-900">
  <h2 class="text-xs uppercase tracking-wider font-mono text-neutral-400 mb-4">
    Kontakt
  </h2>

  <p class="text-sm sm:text-base text-neutral-400 max-w-xl leading-relaxed mb-6">
    Máš dotaz k mým projektům, zájem o spolupráci nebo si chceš vyměnit zkušenosti? Můžeš mě kontaktovat přímo:
  </p>

  <div class="flex flex-col sm:flex-row sm:items-center gap-4 text-sm font-mono">
    <a
      href="mailto:kontakt@patrikrybka.me"
      class="text-neutral-200 hover:text-white underline underline-offset-4 decoration-neutral-700 hover:decoration-white transition-colors"
    >
      kontakt@patrikrybka.me ↗
    </a>
    <span class="hidden sm:inline text-neutral-700">•</span>
    <a
      href="https://github.com/Patrik-Rybka"
      target="_blank"
      rel="noopener noreferrer"
      class="text-neutral-400 hover:text-white transition-colors"
    >
      github.com/Patrik-Rybka ↗
    </a>
  </div>
</section>
