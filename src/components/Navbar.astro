---
const navItems = [
  { name: 'O mně', href: '/#o-mne' },
  { name: 'Projekty', href: '/#projekty' },
  { name: 'Blog', href: '/blog' },
  { name: 'Kontakt', href: '/#kontakt' },
];
---

<header class="sticky top-0 z-50 w-full border-b border-neutral-900 bg-[#0c0c0c]/85 backdrop-blur-md">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
    <!-- Jméno -->
    <a href="/" class="text-sm font-medium text-white hover:text-neutral-300 transition-colors tracking-tight">
      Patrik Rybka
    </a>

    <!-- Navigace -->
    <nav class="flex items-center gap-4 sm:gap-6 text-xs sm:text-sm">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="text-neutral-400 hover:text-white transition-colors"
        >
          {item.name}
        </a>
      ))}
    </nav>
  </div>
</header>
