---
// src/components/LatestPosts.astro
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('cs-CZ', {
    day: 'numeric',
    month: 'numeric',
    year: 'numeric',
  }).format(date);
};
---

<section class="py-12 border-t border-neutral-900">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-xs uppercase tracking-wider font-mono text-neutral-400">
      Zápisky & Blog
    </h2>
    <a 
      href="/blog" 
      class="text-xs font-mono text-neutral-400 hover:text-white transition-colors"
    >
      Všechny články ({posts.length}) ↗
    </a>
  </div>

  <div class="divide-y divide-neutral-900">
    {posts.map((post) => (
      <a 
        href={`/blog/${post.id}`} 
        class="py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2 group block"
      >
        <span class="text-sm font-medium text-neutral-200 group-hover:text-white group-hover:underline underline-offset-4 decoration-neutral-600 transition-colors">
          {post.data.title}
        </span>
        <span class="text-xs font-mono text-neutral-400 whitespace-nowrap">
          {formatDate(post.data.pubDate)}
        </span>
      </a>
    ))}
  </div>
</section>
