---
// src/components/Projects.astro
import ProjectCard from './ProjectCard.astro';

const projects = [
  {
    title: "Osobní web & portfolio",
    description: "Vlastní rychlý web a blog postavený na moderním frameworku Astro s Tailwind CSS. Automaticky nasazovaný na GitHub Pages na vlastní doméně.",
    tags: ["Astro", "Tailwind CSS", "GitHub Actions", "Markdown"],
    githubUrl: "https://github.com/Patrik-Rybka/Patrik-Rybka.github.io",
    liveUrl: "https://patrikrybka.me"
  },
  {
    title: "Školní projekt / Správa úloh",
    description: "Aplikace pro správu úkolů a organizaci školních projektů s ukládáním do databáze a přehledným rozhraním.",
    tags: ["Python", "SQLite", "HTML/CSS", "Git"],
    githubUrl: "https://github.com/Patrik-Rybka",
  },
  {
    title: "Automatizační skripty & Nástroje",
    description: "Kolekce užitečných skriptů pro usnadnění každodenní práce v Linuxu, zálohování a práci se soubory.",
    tags: ["Bash", "Linux", "Python", "CLI"],
    githubUrl: "https://github.com/Patrik-Rybka",
  }
];
---

<section id="projekty" class="py-12 border-t border-neutral-800/60">
  <div class="mb-8">
    <span class="text-xs font-semibold uppercase tracking-wider text-indigo-400">Portfolio</span>
    <h2 class="text-2xl sm:text-3xl font-bold text-white mt-1">Vybrané projekty</h2>
    <p class="text-neutral-400 mt-2 text-sm sm:text-base">
      Ukázky mých projektů, na kterých jsem pracoval ve škole nebo ve volném čase.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    {projects.map((project) => (
      <ProjectCard {...project} />
    ))}
  </div>
</section>
