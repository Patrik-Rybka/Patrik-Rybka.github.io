---
// src/components/Projects.astro
import ProjectCard from './ProjectCard.astro';

const projects = [
  {
    title: "Osobní web, portfolio & blog",
    description: "Rychlý minimalistický web s vizuální administrací obsahu přes Keystatic, optimalizovaný pro rychlost a funkčnost. Nasazen na GitHub Pages s vlastní doménou.",
    tags: ["Astro", "Tailwind CSS", "TypeScript", "Keystatic", "GitHub Actions"],
    githubUrl: "https://github.com/Patrik-Rybka/Patrik-Rybka.github.io",
    liveUrl: "https://patrikrybka.me"
  },
  {
    title: "Školní aplikace pro správu úloh",
    description: "Aplikace pro organizaci projektů a úkolů s databázovým úložištěm a přehledným rozhraním.",
    tags: ["Python", "SQLite", "HTML/CSS", "Git"],
    githubUrl: "https://github.com/Patrik-Rybka"
  },
  {
    title: "Automatizační skripty & CLI utility",
    description: "Kolekce skriptů pro usnadnění práce v Linuxu, správu prostředí a zálohování souborů.",
    tags: ["Bash", "Linux", "Python", "CLI"],
    githubUrl: "https://github.com/Patrik-Rybka"
  }
];
---

<section id="projekty" class="py-12 border-t border-neutral-900">
  <div class="flex items-center justify-between mb-2">
    <h2 class="text-xs uppercase tracking-wider font-mono text-neutral-400">
      Vybrané projekty
    </h2>
    <a 
      href="https://github.com/Patrik-Rybka?tab=repositories" 
      target="_blank" 
      rel="noopener noreferrer"
      class="text-xs font-mono text-neutral-400 hover:text-white transition-colors"
    >
      Vše na GitHubu ↗
    </a>
  </div>

  <div class="divide-y divide-neutral-900">
    {projects.map((project) => (
      <ProjectCard {...project} />
    ))}
  </div>
</section>
