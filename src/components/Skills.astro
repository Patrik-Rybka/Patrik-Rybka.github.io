---
// src/components/Skills.astro

const skills = [
  {
    label: "Jazyky",
    items: "Python, JavaScript, TypeScript, HTML5, CSS3, C#, SQL"
  },
  {
    label: "Web & Stack",
    items: "Astro, Tailwind CSS, Node.js, REST API"
  },
  {
    label: "Nástroje & OS",
    items: "Git, GitHub Actions, Linux (Bash), Docker základy, VS Code"
  },
  {
    label: "Databáze & Sítě",
    items: "PostgreSQL, SQLite, Základy počítačových sítí"
  }
];
---

<section id="o-mne" class="py-12 border-t border-neutral-900">
  <h2 class="text-xs uppercase tracking-wider font-mono text-neutral-400 mb-6">
    Dovednosti & Technologie
  </h2>

  <div class="space-y-4">
    {skills.map((item) => (
      <div class="grid grid-cols-1 sm:grid-cols-4 gap-1 sm:gap-4 py-2.5 border-b border-neutral-900 last:border-none">
        <span class="text-xs font-mono text-neutral-400 uppercase tracking-wide">{item.label}</span>
        <span class="sm:col-span-3 text-sm text-neutral-200">{item.items}</span>
      </div>
    ))}
  </div>
</section>
