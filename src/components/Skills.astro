---
// src/components/Skills.astro

const skillCategories = [
  {
    category: "Programovací jazyky",
    skills: ["Python", "JavaScript / TypeScript", "HTML5 & CSS3", "C# / C++"]
  },
  {
    category: "Web & Frameworky",
    skills: ["Astro", "Tailwind CSS", "Node.js", "REST API"]
  },
  {
    category: "Nástroje & DevOps",
    skills: ["Git & GitHub", "Linux (Bash)", "Docker základy", "VS Code"]
  },
  {
    category: "Databáze & Sítě",
    skills: ["SQL (PostgreSQL / SQLite)", "Základy počítačových sítí", "Figma"]
  }
];
---

<section id="o-mne" class="py-12 border-t border-neutral-800/60">
  <div class="mb-8">
    <span class="text-xs font-semibold uppercase tracking-wider text-indigo-400">Dovednosti</span>
    <h2 class="text-2xl sm:text-3xl font-bold text-white mt-1">Technologie a nástroje</h2>
    <p class="text-neutral-400 mt-2 text-sm sm:text-base">
      Nástroje a technologie, které aktivně používám při studiu, školních úlohách a vlastních projektech.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {skillCategories.map((group) => (
      <div class="p-5 rounded-2xl bg-neutral-900/40 border border-neutral-800/80 hover:border-neutral-700/80 transition-colors">
        <h3 class="text-sm font-semibold text-neutral-200 mb-3 flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span>
          {group.category}
        </h3>
        <div class="flex flex-wrap gap-2">
          {group.skills.map((skill) => (
            <span class="px-3 py-1 rounded-lg text-xs sm:text-sm font-medium bg-neutral-800/60 text-neutral-300 border border-neutral-700/40 hover:text-white hover:border-indigo-500/50 transition-colors">
              {skill}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
